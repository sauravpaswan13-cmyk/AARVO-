<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="AARVO"
        android:icon="@drawable/aarvo_logo"
        android:roundIcon="@drawable/aarvo_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AARVO">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GuestBrowseActivity" android:exported="false" />
        <activity android:name=".PhoneAuthActivity" android:exported="false" />
        <activity android:name=".AarvoAiActivity" android:exported="false" />
        <activity android:name=".AddressBookActivity" android:exported="false" />
        <activity android:name=".AdminDashboardActivity" android:exported="false" />
    </application>
</manifest>
