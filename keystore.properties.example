# Copy this file to keystore.properties locally. Never commit real passwords or keystore files.
# The CI release build remains unsigned unless these Gradle properties are supplied securely.
aarvoReleaseStoreFile=/absolute/path/to/aarvo-release.jks
aarvoReleaseStorePassword=REPLACE_ME
aarvoReleaseKeyAlias=aarvo
 aarvoReleaseKeyPassword=REPLACE_ME
