# AARVO backend environment template
# Never commit real secrets. Put these values in the hosting provider secret store.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aarvo
DATABASE_SSL=true
CORS_ORIGIN=https://your-production-api.example
DELIVERY_FEE_PAISE=0
PLATFORM_FEE_BPS=0
JWT_SECRET=replace-with-32-plus-random-secret
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=replace-with-server-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Launch fallback: allows only KYC-verified/admin-approved sellers to publish while payouts are settled manually.
# Leave false until COD/manual settlement workflow is tested and approved.
AARVO_MANUAL_SELLER_SETTLEMENT_ENABLED=false

# Third-party delivery: AARVO has NO Rider App. Shiprocket handles courier assignment/tracking.
# Keep disabled until Shiprocket API credentials, account pickup access, and webhook are verified.
# Seller pickup locations are registered by API from each seller's saved pickup address.
THIRD_PARTY_DELIVERY_ENABLED=false
THIRD_PARTY_DELIVERY_PROVIDER=shiprocket
THIRD_PARTY_DELIVERY_BASE_URL=https://apiv2.shiprocket.in
THIRD_PARTY_DELIVERY_AUTH_TOKEN=
# Prefer API-user credentials; the backend obtains and refreshes the Shiprocket bearer token automatically.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
THIRD_PARTY_DELIVERY_WEBHOOK_SECRET=
THIRD_PARTY_DELIVERY_WEBHOOK_URL=https://aarvo-api.onrender.com/v1/webhooks/delivery/shiprocket
# Optional fallback pickup location for legacy/single-pickup accounts. Multi-seller uses seller pickup details.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PACKAGE_LENGTH_CM=10
SHIPROCKET_PACKAGE_BREADTH_CM=10
SHIPROCKET_PACKAGE_HEIGHT_CM=10
SHIPROCKET_PACKAGE_WEIGHT_KG=0.5
