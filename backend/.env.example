# AARVO backend environment template
# Never commit real secrets. Put these values in the hosting provider secret store.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aarvo
DATABASE_SSL=true
CORS_ORIGIN=https://your-production-api.example
DELIVERY_FEE_PAISE=0
PLATFORM_FEE_BPS=0
JWT_SECRET=replace-with-32-plus-random-secret
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=replace-with-server-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Third-party delivery provider (no AARVO Rider App required)
THIRD_PARTY_DELIVERY_ENABLED=false
THIRD_PARTY_DELIVERY_PROVIDER=
THIRD_PARTY_DELIVERY_BASE_URL=
THIRD_PARTY_DELIVERY_CREATE_PATH=/shipments
THIRD_PARTY_DELIVERY_AUTH_TOKEN=
THIRD_PARTY_DELIVERY_WEBHOOK_SECRET=
THIRD_PARTY_DELIVERY_WEBHOOK_URL=
