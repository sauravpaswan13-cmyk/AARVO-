# AARVO backend production environment template
# Never commit real secrets. Configure these values in your cloud provider environment store.
NODE_ENV=production
PORT=8080
POSTGRES_PASSWORD=replace-with-db-password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aarvo?sslmode=require
DATABASE_SSL=true
CORS_ORIGIN=https://aarvo-app.web.app
DELIVERY_FEE_PAISE=0
PLATFORM_FEE_BPS=0
JWT_SECRET=replace-with-32-plus-random-secret
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=replace-with-server-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Seller settlement and cash-on-delivery controls
AARVO_MANUAL_SELLER_SETTLEMENT_ENABLED=true
AARVO_COD_ENABLED=true

# Shiprocket logistics integration
THIRD_PARTY_DELIVERY_ENABLED=false
THIRD_PARTY_DELIVERY_PROVIDER=shiprocket
THIRD_PARTY_DELIVERY_BASE_URL=https://apiv2.shiprocket.in
THIRD_PARTY_DELIVERY_AUTH_TOKEN=
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
THIRD_PARTY_DELIVERY_WEBHOOK_SECRET=
THIRD_PARTY_DELIVERY_WEBHOOK_URL=https://aarvo-api.onrender.com/v1/webhooks/delivery/shiprocket
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PACKAGE_LENGTH_CM=10
SHIPROCKET_PACKAGE_BREADTH_CM=10
SHIPROCKET_PACKAGE_HEIGHT_CM=10
SHIPROCKET_PACKAGE_WEIGHT_KG=0.5
