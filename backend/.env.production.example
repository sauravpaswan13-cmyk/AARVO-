# Copy to .env for a production deployment and replace every placeholder.
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
POSTGRES_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Razorpay: keep live keys private and configure them in your deployment secret store.
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# Shiprocket credentials are the Shiprocket API user's email and password.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
THIRD_PARTY_DELIVERY_PROVIDER=shiprocket
THIRD_PARTY_DELIVERY_ENABLED=false
THIRD_PARTY_DELIVERY_WEBHOOK_SECRET=

# Set actual packed parcel measurements before enabling live shipment creation.
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_PACKAGE_WEIGHT_KG=
