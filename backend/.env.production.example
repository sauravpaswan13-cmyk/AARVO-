# Copy to .env.production locally or provide the same variables through your hosting platform.
# Never commit real secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CORS_ORIGIN=https://api.your-domain.example
JWT_SECRET=replace-with-at-least-32-random-characters
DELIVERY_FEE_PAISE=0
PLATFORM_FEE_BPS=0
PAYMENT_WINDOW_MINUTES=15
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=replace-with-server-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
